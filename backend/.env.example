# Environment configuration for SmartParkAI Backend

# Application
ENV=development
DEBUG=true
PROJECT_NAME="SmartPark AI"
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Model Configuration
MODEL_REPO="simahanyan/parking-lot-yolo26m"
MODEL_FILENAME="weights/parking_lot.pt"
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IMAGE_SIZE=1280
PRELOAD_MODEL_ON_STARTUP=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# File Storage
MAX_FILE_SIZE_BYTES=15728640
